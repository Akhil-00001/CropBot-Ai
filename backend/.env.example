# Copy this file to .env and fill it in. Never commit .env.
# Set ONE of these. If both are set, Groq is used.
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Frontend address(es) allowed to call this API, comma-separated.
ALLOWED_ORIGINS=http://localhost:5173

# Optional
# PORT=3001
# CROPBOT_MODEL=openai/gpt-oss-120b
